# Server
PORT=4000

# MongoDB
MONGO_URI=mongodb://localhost:27017/deployments

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# EC2 instance (for SSM SendCommand)
# Must have SSM agent installed and IAM role with AmazonSSMManagedInstanceCore
EC2_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx

# Lambda function to invoke for post-deploy setup
LAMBDA_FUNCTION_NAME=post-deploy-hook

# Set to true to simulate AWS calls without real credentials
DEMO_MODE=true
